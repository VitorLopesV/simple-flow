{
  "name": "financial-control",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Controle Financeiro - monorepo (frontend Vue 3 + backend futuro)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "type-check": "npm run type-check --workspace frontend",
    "type-check:backend": "npm run type-check --workspace backend"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
