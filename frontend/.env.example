# URL base da API REST (usada quando VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:3000/api

# true  -> usa a camada de mock em memória (src/services/mock)
# false -> usa o backend real via Axios
VITE_USE_MOCK=true

# Latência artificial (ms) simulada pelo mock, para exercitar loadings/skeletons
VITE_MOCK_LATENCY=350
