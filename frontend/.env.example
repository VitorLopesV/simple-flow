# URL base da API REST (usada quando VITE_USE_MOCK não é "true")
VITE_API_URL=http://localhost:3000/api

# true            -> usa a camada de mock em memória (src/services/mock), sem backend
# ausente/outro   -> usa o backend real via Axios (padrão seguro para deploy)
# Nunca use true em produção: no modo mock o login aceita qualquer e-mail e senha.
VITE_USE_MOCK=true

# Latência artificial (ms) simulada pelo mock, para exercitar loadings/skeletons
VITE_MOCK_LATENCY=350
